# Claude Code does NOT read this file automatically.
#
# The recommended way to set your key is inside Claude Code, which stores it in
# your OS keychain rather than a file in the repo:
#
#     /plugin configure stepwarden
#
# If you prefer a file, source it into your shell before starting Claude Code:
#
#     set -a; . ./.env; set +a
#     claude --plugin-dir .

TYPESAFE_API_KEY=

# Function hooks are early access and must be switched on explicitly.
CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1
